{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelContextProtocol": "Warning"
    }
  },
  "InfraLens": {
    "Region": "us-east-2",
    "ClusterName": "infralens-sandbox",
    "AllowedServices": [ "infralens-api" ],
    "AllowedLogGroupPrefixes": [ "/ecs/infralens-sandbox/" ],
    "DefaultLogGroup": "/ecs/infralens-sandbox/api",
    "TaskFamilyPrefix": "infralens-",
    "MaxTier": "Read",
    "MaxOutputChars": 12000,
    "MaxCallsPerSession": 60,
    "MaxWindowMinutes": 1440,
    "AuditTableName": null
  }
}
